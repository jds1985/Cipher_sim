# Copy to .env.local for local work, and add the same names in Vercel > Project > Settings > Environment Variables.
# NEVER commit real values. Real .env files are ignored by git; only this example file is tracked.
# Full walkthrough in plain language: docs/STRIPE_SETUP.md

# ---- Stripe (use TEST keys, sk_test_ / pk_test_, until you are ready to take real money) ----
# Secret key, server only. Stripe Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# Publishable key, safe for the browser. The "Purchase" button on /hlc stays off until this is set.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...). From the webhook endpoint page, or printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Optional. "true" adds Stripe's required "I agree to the terms" checkbox on the Checkout page. Stripe refuses it until a
# Terms of service URL (https://ciphercts.com/hlc/commercial-terms) is saved in Dashboard > Settings > Public details.
# Leave empty and the terms link still appears on the Checkout page (custom_text.submit). See docs/STRIPE_SETUP.md.
STRIPE_REQUIRE_TERMS_CHECKBOX=

# ---- One-time download link ----
# Any long random string (for example the output of: openssl rand -hex 32). Signs the emailed links.
DOWNLOAD_LINK_SECRET=
# Where the PRIVATE production package lives: a private/signed https URL, or a file path on the server.
# Never put the package inside /public. Contents of the package are still to be defined.
PRODUCTION_PACKAGE_URL=
# Upstash Redis / Vercel KV REST credentials (free tier is enough). Used so each link works only once.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Email (Resend) ----
RESEND_API_KEY=
# Must be on a domain verified in Resend, for example licensing@ciphercts.com
FROM_EMAIL=

# ---- Site ----
# Public origin used for links in emails and as the checkout return address. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://ciphercts.com
